PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
EMAIL_USER=
EMAIL_PASS=
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
ARCGIS_REFERER=
# Required to call the /upgrade-member and /upgrade-gm admin endpoints
ADMIN_API_KEY=
# Comma-separated emails of in-app content admins (can manage map scenario images)
ADMIN_EMAILS=
# Optional: where uploaded images are stored (default: backend/uploads)
UPLOAD_DIR=
# Optional: comma-separated browser origins allowed by CORS (unset = allow all, dev only)
CORS_ORIGINS=
